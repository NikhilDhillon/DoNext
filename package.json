{
  "name": "donext",
  "version": "0.1.0",
  "private": true,
  "author": "Nikhil Dhillon",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:api": ".venv/bin/uvicorn donext.main:app --app-dir apps/api/src --reload",
    "dev:web": "pnpm --filter @donext/web dev",
    "build:web": "pnpm --filter @donext/web build",
    "lint:web": "pnpm --filter @donext/web lint",
    "typecheck:web": "pnpm --filter @donext/web typecheck",
    "lint:api": ".venv/bin/ruff check apps/api && .venv/bin/ruff format --check apps/api",
    "typecheck:api": ".venv/bin/mypy apps/api/src",
    "test:api": ".venv/bin/pytest apps/api",
    "migrate:api": ".venv/bin/alembic -c apps/api/alembic.ini upgrade head",
    "check": "pnpm lint:web && pnpm typecheck:web && pnpm lint:api && pnpm typecheck:api && pnpm test:api && pnpm build:web"
  }
}
